# Load inside http {}. Replace example.com, upstream port and TLS paths.
# Certificate SANs: terminal.example.com and *.preview.example.com.
map $http_upgrade $workbench_connection { default upgrade; '' close; }
log_format workbench_safe '$time_iso8601 status=$status seconds=$request_time upstream=$upstream_response_time';
upstream workbench_backend { server 127.0.0.1:8790; } # Separate gateway: use 18790.
server {
    listen 80;
    server_name terminal.example.com *.preview.example.com;
    access_log off;
    error_log /dev/null;
    return 308 https://$host$request_uri;
}
server {
    listen 443 ssl http2; # Compatible with Ubuntu 24.04 Nginx 1.24.
    server_name terminal.example.com *.preview.example.com;
    ssl_certificate /etc/letsencrypt/live/codock/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/codock/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:WorkbenchTLS:10m;
    ssl_session_timeout 1d;
    # Callback code and preview tickets must never enter access logs.
    access_log /var/log/nginx/workbench-access.log workbench_safe;
    # Nginx error logs can include request URLs. Off by default; use sanitized application diagnostics.
    error_log /dev/null;
    client_max_body_size 24k;
    gzip on;
    gzip_types text/css text/javascript application/javascript application/json image/svg+xml;
    location / {
        proxy_pass http://workbench_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $workbench_connection;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        proxy_send_timeout 30s;
        proxy_buffering off;
        proxy_cache off;
        proxy_next_upstream off; # Never replay terminal input POSTs.
    }
}
